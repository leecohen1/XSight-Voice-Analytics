# Copy this file to .env and adjust as needed.

# Base URL of call_data_service (S3-backed business persistence + Overview
# aggregation). REQUIRED -- Overview, Calls, Call Details and Team
# Intelligence read exclusively from here and have NO mock fallback: if this
# is unset or the service is unreachable, those screens show a real error
# rather than demo data.
#
# Point this at the deployed EC2 service through its Nginx reverse proxy on
# port 80 (http://<EC2_PUBLIC_IP>), not at a localhost/Docker-internal port --
# the browser, not the server, makes these requests.
VITE_CALL_DATA_SERVICE_URL=http://localhost:8006

# The n8n Cloud (or local n8n) webhook URL that receives the multipart upload
# (audio file + form fields) and returns the analysis envelope
# ({call_id, created_at, agent_name, ..., analysis, persistence}).
# REQUIRED for Analyze Call.
VITE_N8N_WEBHOOK_URL=

# Legacy developer toggle. Now read ONLY by the AI Operations and Ask XSight
# modules, which are future (non-Phase-1) features and remain mock-backed
# because no backend contract exists for them yet. It has NO effect on
# Overview, Analyze Call, Calls, Call Details or Team Intelligence -- those
# are real-backend only, by design.
VITE_USE_MOCK=true
