# Copy this file to .env and adjust as needed.

# Base URL of call_data_service (S3-backed business persistence + Overview
# aggregation). REQUIRED -- Overview, Calls and Call Details read exclusively
# from here and have NO mock fallback: if this is unset or the service is
# unreachable, those screens show a real error rather than demo data.
VITE_CALL_DATA_SERVICE_URL=http://localhost:8006

# The n8n Cloud (or local n8n) webhook URL that receives the multipart upload
# (audio file + form fields) and returns the analysis envelope
# ({call_id, created_at, agent_name, ..., analysis, persistence}).
# REQUIRED for Analyze Call.
VITE_N8N_WEBHOOK_URL=

# Legacy developer toggle. Still read by the not-yet-migrated Team
# Intelligence / AI Operations / Ask XSight modules, which remain mock-backed
# because no backend contract exists for them yet. It has NO effect on
# Overview, Calls, Call Details or Analyze Call -- those are real-backend
# only, by design.
VITE_USE_MOCK=true
