# Copy this file to .env and adjust as needed.

# When "true", the app skips the real n8n webhook call entirely and returns
# the fixture in src/mocks/exampleAnalysis.json instead. Useful for demoing
# the Results Page before/without a live n8n workflow.
VITE_USE_MOCK=true

# The n8n Cloud (or local n8n) webhook URL that receives the multipart
# upload (audio file + form fields) and returns the final output JSON
# (see CLAUDE.md "Final output JSON schema"). Only used when
# VITE_USE_MOCK=false.
VITE_N8N_WEBHOOK_URL=
