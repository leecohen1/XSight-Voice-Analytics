# call_data_service -- environment variables
#
# AWS credentials are never read from this file. boto3 resolves them through
# the standard AWS credential chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# set outside this file, ~/.aws/credentials, or an EC2 instance role) --
# never hardcode a key here or anywhere in application code.

# Port the service listens on (also set in docker-compose.yml and the Dockerfile).
PORT=8006

# Required. Same bucket the RAG corpus lives in -- a different prefix.
AWS_REGION=us-east-2
XSIGHT_S3_BUCKET=xsight-sales-call-analytics-881490130721-us-east-2

# Where analyzed business records are stored. MUST stay outside the Bedrock
# Knowledge Base data source's inclusionPrefixes, so a live call can never be
# ingested into the RAG corpus. The service refuses to start if this resolves
# inside the forbidden prefix below.
XSIGHT_APPLICATION_PREFIX=xsight/application/analyzed-calls/v1/

# The Bedrock ingestion prefix this service must never write to. Every key is
# checked against it before any Get/Put/List.
XSIGHT_BEDROCK_FORBIDDEN_PREFIX=xsight/bedrock/

# List paging defaults.
DEFAULT_LIST_LIMIT=100
MAX_LIST_LIMIT=500

LOG_LEVEL=INFO

# Optional: point boto3 at an S3-compatible endpoint for local experiments.
# Leave unset in every real deployment.
S3_ENDPOINT_URL=
