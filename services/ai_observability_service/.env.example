# ai_observability_service — environment variables
#
# This service holds no secrets of its own beyond the optional Langfuse
# keys below. Fixed infrastructure cost (EC2, n8n subscription, etc.) comes
# from data entered into the infrastructure_cost_config table, never from
# application code.

PORT=8005

# Path to the local SQLite file. Only pricing_config and
# infrastructure_cost_config live here now -- per-event token/cost/latency
# telemetry is owned by Langfuse, not this database (see app/db.py).
# Created automatically (including parent directories) on first startup if
# it doesn't exist yet. Never committed to git -- persist it via a mounted
# Docker volume in any real deployment.
AI_OBSERVABILITY_DB_PATH=./data/ai_observability.db

# Safety limit on how many events a single POST /observability/events call
# may contain -- protects against an unbounded batch from a misbehaving caller.
MAX_EVENTS_PER_BATCH=100

LOG_LEVEL=INFO

# --- Langfuse ----------------------------------------------------------------
# Both LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY must be set for
# observability to be "enabled" -- there is no separate on/off flag. Left
# unset here on purpose: no real Langfuse account has been created as part
# of this project's Phase 1 work, so this service runs in "disabled mode"
# (every Langfuse call becomes a documented no-op) until real credentials
# are supplied. See app/langfuse_client.py.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=development
# Optional free-text release/version tag attached to every trace.
LANGFUSE_RELEASE=
# Bounded timeout for the Langfuse SDK's own HTTP calls -- observability
# must never be allowed to slow down call analysis.
LANGFUSE_TIMEOUT_SECONDS=3.0
