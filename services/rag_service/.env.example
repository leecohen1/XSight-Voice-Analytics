# rag_service — environment variables
#
# AWS credentials are never read from this file. boto3 resolves them through
# the standard AWS credential chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# environment variables set outside this file, ~/.aws/credentials, or an IAM
# role) — never hardcode a key here or anywhere in application code.

# Port the service listens on (also set in docker-compose.yml and the Dockerfile).
PORT=8001

# Path to the RAG corpus CSV, relative to the service's working directory.
# Reference/logging only — this service retrieves through Bedrock, it never
# reads or ingests the CSV directly.
HISTORICAL_CALLS_CSV_PATH=../../data/historical_sales_calls.csv

# Amazon Bedrock Knowledge Base — provisioned (see docs/PROGRESS.md for the
# full provisioning record: resource ARNs, ingestion job IDs, and the
# S3 Vectors non-filterable-metadata-key requirement). Not secrets — these
# are resource identifiers, safe to commit.
AWS_REGION=us-east-2
BEDROCK_KNOWLEDGE_BASE_ID=EDCC0WT0OB
BEDROCK_DATA_SOURCE_ID=UDNMPNSGXZ
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_VECTOR_INDEX_NAME=xsight-historical-calls-index
XSIGHT_S3_BUCKET=xsight-sales-call-analytics-881490130721-us-east-2
XSIGHT_S3_PREFIX=xsight/bedrock/historical-calls/v1/

# Path to the shared ingestion metadata schema (single source of truth for
# which fields may be used as retrieval filters). Defaults to the real file
# in services/rag_service/ingestion/ — override only if running from a
# non-standard layout (e.g. inside Docker, see Dockerfile).
METADATA_SCHEMA_PATH=
